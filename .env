
# ▃▃▃▃▃▃▃▃▃▃▃▃ Kalio — development shop ▃▃▃▃▃▃▃▃▃▃▃▃
# These VITE_* values are public client configuration and are only read in
# development. In production Selldone injects the real shop, defaults and
# theme of whichever shop runs this Layout.

VITE_APP_SAMPLE_SHOP_NAME=molino

# Kalio's shop record has home="31567" (a Page Builder landing page). The
# designed grocery home in this Layout is the shop page, so development points
# at `shop`; switching the shop's Home setting to "Shop page" makes production
# match. Values: blog | avocado | hyper | community | shop | map | <page id>
VITE_APP_SAMPLE_SHOP_CUSTOM_HOME=shop

VITE_APP_SAMPLE_DEFAULT_CURRENCY=USD
VITE_APP_SAMPLE_DEFAULT_COUNTRY=US
VITE_APP_SAMPLE_DEFAULT_LANGUAGE=en

# Walio palette: blue, deep navy, spark yellow.
VITE_APP_SAMPLE_THEME_COLOR_LIGHT="#0071DC"
VITE_APP_SAMPLE_THEME_COLOR_DARK="#004F9A"
VITE_APP_SAMPLE_THEME_COLOR_DEEP_DARK="#041E42"
VITE_APP_SAMPLE_THEME_COLOR_INFO="#FFC220"

# ▃▃▃▃▃▃▃▃▃▃▃▃ Dev Server ▃▃▃▃▃▃▃▃▃▃▃▃

VITE_APP_DEV_SERVER_HOST=localhost
VITE_APP_DEV_SERVER_PORT=9127
VITE_APP_DEV_SERVER_HTTPS=FALSE
